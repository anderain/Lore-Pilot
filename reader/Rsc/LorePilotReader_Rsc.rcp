// LorePilotReader_Rsc.rcp
//
// PilRC resources for LorePilotReader.
// Palm OS 2.0-safe subset only:
//   - plain ICON / SMALLICON (no icon families)
//   - TITLE / BUTTON / ALERT / LIST / LABEL / MENU
//   - no Graffiti state indicator, no NOSAVEBEHIND
//
// IDs are symbolic: PilRC assigns them (RESETAUTOID 1000 upward) and writes
// LorePilotReader_Rsc.h, which is the single source of truth for the C code.
// Keep the declaration order stable so generated IDs remain stable.

GENERATEHEADER "LorePilotReader_Rsc.h"
RESETAUTOID 1000

ALERT ID RomIncompatibleAlert
    DEFAULTBUTTON 0
    ERROR
BEGIN
    TITLE "System Incompatible"
    MESSAGE "Palm OS 2.0 or greater is required to run this application."
    BUTTONS "OK"
END

ALERT ID AboutAlert
    DEFAULTBUTTON 0
    INFORMATION
BEGIN
    TITLE "About"
    MESSAGE "LorePilot Bookshelf\r\rBooks: LPBK volumes from lore-teller. Each volume installs and reads on its own.\rFonts: LPF08B/F (8x8), LPF12B/F (12x12).\r\rTest menu runs the glyph and Qianziwen tests."
    BUTTONS "OK"
END

ALERT ID DeleteFontAlert
    DEFAULTBUTTON 1
    WARNING
BEGIN
    TITLE "Delete Font"
    MESSAGE "^0\r\rDelete this font database?"
    BUTTONS "Delete" "Cancel"
END

ALERT ID DeleteFailedAlert
    DEFAULTBUTTON 0
    ERROR
BEGIN
    TITLE "Delete Failed"
    MESSAGE "Could not delete ^0."
    BUTTONS "OK"
END

ALERT ID DeleteBookAlert
    DEFAULTBUTTON 1
    WARNING
BEGIN
    TITLE "Delete Volume"
    MESSAGE "^0\r\rDelete this volume? Other volumes of the book stay installed."
    BUTTONS "Delete" "Cancel"
END

ALERT ID DeleteBookFailedAlert
    DEFAULTBUTTON 0
    ERROR
BEGIN
    TITLE "Delete Failed"
    MESSAGE "Could not delete ^0."
    BUTTONS "OK"
END

ALERT ID OpenBookFailedAlert
    DEFAULTBUTTON 0
    ERROR
BEGIN
    TITLE "Open Failed"
    MESSAGE "Could not open ^0.\r\rThe volume file may be missing or damaged."
    BUTTONS "OK"
END

MENU ID MainMenu
BEGIN
    PULLDOWN "Test"
    BEGIN
        MENUITEM "Glyph 8x8"     ID TestGlyph8x8
        MENUITEM "GB2312 8x8"    ID TestGb8x8
        MENUITEM "GB2312 12x12"  ID TestGb12x12
    END
    PULLDOWN "Options"
    BEGIN
        MENUITEM "Refresh Lists" ID CmdRefreshList
        MENUITEM SEPARATOR
        MENUITEM "About"         ID CmdAbout
    END
END

// Bookshelf. Coordinates are form-relative; the title bar covers the top ~15
// rows and Palm OS 2.0 draws the menu bar at the bottom, so content stays
// inside y 16..147 (the original main form ended at 142). Palm convention for
// a list height is visibleItems * 11 + 2, as in the CodeWarrior samples.
FORM ID MainForm AT (0 0 160 160)
    MENUID MainMenu
BEGIN
    TITLE "Bookshelf"

    LIST ""                 ID MainBookList         AT (2 27 156 46) VISIBLEITEMS 4
    LIST ""                 ID MainFontList         AT (2 99 156 35) VISIBLEITEMS 3
END

// Full-screen page reader: everything is drawn in code, so the form holds no
// objects at all.
FORM ID ReaderForm AT (0 0 160 160)
    NOFRAME
BEGIN
END

// Page jump panel: a self-drawn keypad, no form objects. Real FIELD objects
// cannot be used here: PilRC's FieldAttrType packing differs from the one Palm
// OS 2.0 reads, so a form containing a FIELD has its object table misread and
// its controls land offscreen. See GotoForm.c.
FORM ID GotoForm AT (0 0 160 160)
    NOFRAME
BEGIN
END

FORM ID GlyphTestForm AT (0 0 160 160)
    NOFRAME
BEGIN
    BUTTON "Reload" ID GlyphTestReloadButton AT (2 146 52 12)
    BUTTON "Back"   ID GlyphTestBackButton   AT (106 146 52 12)
END

FORM ID GbTestForm AT (0 0 160 160)
    NOFRAME
BEGIN
    BUTTON "Prev" ID GbTestPrevButton AT (2 146 38 12)
    BUTTON "Next" ID GbTestNextButton AT (42 146 38 12)
    BUTTON "Load" ID GbTestLoadButton AT (82 146 38 12)
    BUTTON "Back" ID GbTestBackButton AT (122 146 38 12)
END

ICON ID 1000 "icon-lg-1.bmp"
SMALLICON ID 1001 "icon-sm-1.bmp"
