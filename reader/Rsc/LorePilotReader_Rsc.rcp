// LorePilotReader_Rsc.rcp
//
// PilRC resources for LorePilotReader.
// Palm OS 2.0-safe subset only:
//   - plain ICON / SMALLICON (no icon families)
//   - TITLE / BUTTON / ALERT / LIST / MENU
//   - no Graffiti state indicator, no NOSAVEBEHIND
//
// IDs are symbolic: PilRC assigns them (RESETAUTOID 1000 upward) and writes
// LorePilotReader_Rsc.h, which is the single source of truth for the C code.
// Keep the declaration order stable so generated IDs remain stable.

GENERATEHEADER "LorePilotReader_Rsc.h"
RESETAUTOID 1000

ALERT ID RomIncompatibleAlert
    DEFAULTBUTTON 0
    ERROR
BEGIN
    TITLE "System Incompatible"
    MESSAGE "Palm OS 2.0 or greater is required to run this application."
    BUTTONS "OK"
END

ALERT ID AboutAlert
    DEFAULTBUTTON 0
    INFORMATION
BEGIN
    TITLE "About"
    MESSAGE "LorePilot Reader\r\rFonts: LPF08B/F (8x8), LPF12B/F (12x12)\r\rTest menu runs the glyph and Qianziwen tests."
    BUTTONS "OK"
END

ALERT ID DeleteFontAlert
    DEFAULTBUTTON 1
    WARNING
BEGIN
    TITLE "Delete Font"
    MESSAGE "^0\r\rDelete this font database?"
    BUTTONS "Delete" "Cancel"
END

ALERT ID DeleteFailedAlert
    DEFAULTBUTTON 0
    ERROR
BEGIN
    TITLE "Delete Failed"
    MESSAGE "Could not delete ^0."
    BUTTONS "OK"
END

MENU ID MainMenu
BEGIN
    PULLDOWN "Test"
    BEGIN
        MENUITEM "Glyph 8x8"     ID TestGlyph8x8
        MENUITEM "GB2312 8x8"    ID TestGb8x8
        MENUITEM "GB2312 12x12"  ID TestGb12x12
    END
    PULLDOWN "Options"
    BEGIN
        MENUITEM "Refresh List"  ID CmdRefreshList
        MENUITEM SEPARATOR
        MENUITEM "About"         ID CmdAbout
    END
END

FORM ID MainForm AT (0 0 160 160)
    MENUID MainMenu
BEGIN
    TITLE "LorePilot Fonts"
    LIST "" ID MainFontList AT (2 18 156 104) VISIBLEITEMS 7
    BUTTON "-" ID MainDeleteButton AT (2 128 20 14)
END

FORM ID GlyphTestForm AT (0 0 160 160)
    NOFRAME
BEGIN
    BUTTON "Reload" ID GlyphTestReloadButton AT (2 146 52 12)
    BUTTON "Back"   ID GlyphTestBackButton   AT (106 146 52 12)
END

FORM ID GbTestForm AT (0 0 160 160)
    NOFRAME
BEGIN
    BUTTON "Prev" ID GbTestPrevButton AT (2 146 38 12)
    BUTTON "Next" ID GbTestNextButton AT (42 146 38 12)
    BUTTON "Load" ID GbTestLoadButton AT (82 146 38 12)
    BUTTON "Back" ID GbTestBackButton AT (122 146 38 12)
END

ICON ID 1000 "icon-lg-1.bmp"
SMALLICON ID 1001 "icon-sm-1.bmp"
